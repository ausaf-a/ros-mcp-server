<?xml version="1.0"?>
<robot name="test_robot">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <link name="tool0"/>
  <joint name="tool_joint" type="fixed">
    <parent link="base_link"/>
